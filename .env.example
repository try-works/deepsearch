# Deployment credentials for `pnpm exec alchemy deploy`.
# Copy to your shell environment or a local .env (which is git-ignored).
#
# Workers Scripts:Edit, Zone:Edit and DNS:Edit are needed for the routes and the
# proxied DNS record the Worker route depends on.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cookie-signing key for persisted Worker state. At least 32 characters.
# Deployed as a secret binding (secret_text) and never readable from the dashboard.
# Required for any non-local stage.
STATE_KEY=